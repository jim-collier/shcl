#!/usr/bin/env bash

##	- Purpose: Run the correctness gate before a push reaches a protected branch,
##	  so nothing lands on main or dev unverified even outside a full cicd run.
##	- Feature branches push without waiting: the gate belongs where the work
##	  integrates, not on every intermediate commit.
##	- The gate runs on the commit being pushed, checked out into a throwaway
##	  worktree, not on the working tree: an uncommitted fix must not pass a
##	  broken commit, and an uncommitted breakage must not block a good one. The
##	  worktree shares the main checkout's cargo target dir, so it is not a
##	  rebuild from nothing. If git cannot create one, the gate runs in place with
##	  a warning, as before.
##	- The large-document stage is left out here (minutes, and the hosted workflow
##	  runs the full gate anyway); this is the fast correctness half.
##	- Escape hatch: `git push --no-verify`, or SHCL_SKIP_HOOK=1.
##	- Installed by pointing git at this directory:
##		git config core.hooksPath cicd/hooks

##	Copyright © 2026 Jim Collier (CryptogID: ѳ6ᴚ℈𐀘𐇦ɛ𐊁¥Mﾏb϶Δ𐌞)
##	Licensed under The MIT License (MIT). Full text at:
##		https://mit-license.org/
##	SPDX-License-Identifier: MIT

set -Eeuo pipefail

[[ -n "${SHCL_SKIP_HOOK:-}" ]] && exit 0

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${here}/../.." && pwd)"

## stdin carries "<local ref> <local sha> <remote ref> <remote sha>" per ref.
## Only a push that would move main or dev is worth the wait; the sha that
## would land there is what gets tested. All zeros means a delete: nothing to test.
## Remember the name inside the loop: the read that ends it clears the vars.
gatedRef=""; gatedSha=""
while read -r _localRef localSha remoteRef _remoteSha; do
	case "${remoteRef}" in
		refs/heads/main|refs/heads/dev)
			[[ "${localSha}" =~ ^0+$ ]] && continue
			gatedRef="${remoteRef#refs/heads/}"; gatedSha="${localSha}" ;;
	esac
done
[[ -n "${gatedRef}" ]] || exit 0

echo
echo "[ pre-push: running the correctness gate on ${gatedSha:0:12} before ${gatedRef} ]"
echo

## A detached worktree at the pushed commit. The cargo target dir is linked in
## from the main checkout rather than pointed at through CARGO_TARGET_DIR, so
## the config's relative binary paths (the crosscheck's binding list) still
## resolve inside the worktree.
tmpTree="$(mktemp -d "${TMPDIR:-/tmp}/shcl-prepush.XXXXXX")"
treeAdded=0
# shellcheck disable=SC2329  # runs from the EXIT trap
fCleanup(){
	if ((treeAdded)); then git -C "${root}" worktree remove --force "${tmpTree}" >/dev/null 2>&1 || true; fi
	rm -rf "${tmpTree}"
	git -C "${root}" worktree prune >/dev/null 2>&1 || true
}
trap fCleanup EXIT
if git -C "${root}" worktree add --detach "${tmpTree}" "${gatedSha}" >/dev/null 2>&1; then
	treeAdded=1
	gateRoot="${tmpTree}"
	mkdir -p "${root}/source/rust/target"
	ln -s "${root}/source/rust/target" "${tmpTree}/source/rust/target"
else
	echo "[ pre-push: WARNING: could not check ${gatedSha:0:12} out into a worktree; gating the working tree instead ]" >&2
	gateRoot="${root}"
fi

if "${gateRoot}/cicd/cicd.bash" --ci --no-largedoc; then
	exit 0
fi

echo
echo "[ pre-push: the gate failed - push refused (--no-verify overrides) ]" >&2
echo
exit 1
