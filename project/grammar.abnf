; SHCL - Simple Hierarchical Config Language
; Formal grammar (ABNF, RFC 5234 + RFC 7405 case-sensitive strings).
;
; ABNF cannot express indentation sensitivity or fenced-block termination on
; its own; those are context-sensitive and are specified in prose in spec.md
; (see "Structure & hierarchy" and "Raw blocks"). This grammar covers the
; line-level and value-level syntax. Where a rule depends on runtime context
; (current indent stack, active fence), that dependency is noted inline.

;-----------------------------------------------------------------------------
; File
;-----------------------------------------------------------------------------

file            = *line
line            = ( blank-line / comment-line / field-line / array-elem-line / fence-line / raw-content-line ) newline
                ; raw-content-line only occurs while a fence is open (context).

blank-line      = *wsp [ comment ]
comment-line    = *wsp comment
comment         = "#" *non-newline           ; to end of line; only outside quotes, and only
                                              ; first on the line or after a wsp - a "#" glued
                                              ; to the text before it is content (c#, x#y, [#2])

;-----------------------------------------------------------------------------
; Field lines
;-----------------------------------------------------------------------------
; A field-line's leading whitespace (indent) is significant and governs
; hierarchy per the indentation rules in spec.md. The dotted/bracketed path
; below is the inline-hierarchy sugar; it is exactly equivalent to nesting.

field-line      = indent path *wsp ":" *wsp [ value ] *wsp [ comment ]
                / indent path *wsp ":" *wsp fence-open *wsp [ comment ]   ; raw block, same-line spelling
                ; Semantic (not expressible in ABNF): a selector on the LAST path
                ; segment already supplies that instance's value, so a trailing
                ; value (field[disc]: value) is grammar-legal but not a valid
                ; binding - the instance is created from the discriminator and the
                ; value is reported (Error) and dropped. See spec.md "Selectors".
                ; Semantic likewise: the wildcard selector [*] is query-only. On
                ; a binding line it is grammar-legal but reported (Error,
                ; "wildcard selector is query-only") and the whole line skipped.
                ; An index-sel on a binding line selects an existing instance
                ; by position and creates nothing: with no instance there the
                ; line is reported (Error E003) and dropped, since a file names
                ; an instance by its value, not by a position the next edit
                ; could move.

indent          = *( SP / HTAB )              ; one kind per subtree (see spec)

path            = segment *( *wsp "." *wsp segment )
segment         = field-name *wsp [ selector ]
                ; a "[" right after the name (wsp allowed) is a selector; a "["
                ; after the ":" starts the value, which the parser refuses as
                ; bracket-array spelling (E019). The same path syntax is the
                ; query syntax, so a file line and a Get() read identically.
selector        = "[" *wsp sel-body *wsp "]"
sel-body        = index-sel / value-sel
index-sel       = "#" [ "+" ] 1*DIGIT         ; explicit index
                / [ "+" ] 1*DIGIT              ; bare integer = index
                ; a leading "+" is accepted either way (list[+1] = list[1]);
                ; "-" is not an index sign - [-1] is a value selector.
value-sel       = quoted / bare-sel           ; non-numeric bare, or quoted (forces value)
bare-sel        = 1*sel-char
sel-char        = %x00-09 / %x0B-5C / %x5E-10FFFF
                ; any char but "]" - a bare selector's scan runs to the first
                ; "]", so ".", ":", "\", quotes mid-text (base[O'Brien]) and
                ; non-ASCII all pass through verbatim (base[St.Paul].p
                ; resolves). A "#" after a wsp opens a comment here as anywhere,
                ; which leaves the selector unterminated (E014); glued to the
                ; text it is content (a[x#y], the [#N] index). A quote is a
                ; quote only as the body's first char, closing at the next
                ; matching one, which must be last before the "]"; a body that
                ; opens one and never closes it that way is kept as text and
                ; reported (E017). To embed a "]", quote the discriminator:
                ; base["a]b"].

field-name      = quoted / bare-name
bare-name       = 1*name-char
name-char       = ALPHA / DIGIT / "-" / "_"

;-----------------------------------------------------------------------------
; Values
;-----------------------------------------------------------------------------
; Type is NOT encoded in syntax; every value is stored as raw text and typed
; on read by the consumer (accessor-driven). "array" is the only value-level
; structural distinction (comma-separated). Numbers/bools/dates are recognized
; only at read time by the coercion rules in spec.md.

value           = array / scalar
array           = [ scalar ] *( *wsp "," *wsp [ scalar ] )   ; empty slots (leading/doubled/trailing comma) parse then drop on read; all-comma or empty = empty array; quote "" for a real empty element (spec.md, Arrays)
scalar          = quoted / bareword

quoted          = dquoted / squoted
dquoted         = DQUOTE *dqchar DQUOTE
squoted         = SQUOTE *sqchar SQUOTE
dqchar          = escape / ( %x00-21 / %x23-5B / %x5D-10FFFF )  ; not '"' unescaped
sqchar          = %x00-26 / %x28-10FFFF       ; anything but "'": single quotes are literal,
                                              ; a "\" inside them is a character
                ; A quoted piece is quoted only when its first char is the quote
                ; and the matching quote that closes it is the last thing before
                ; the piece ends (a ",", a "]", a comment or the line end).
                ; Anywhere else a quote is a bare-char; a piece that opens one
                ; and never closes it that way is read bare, quotes and all, and
                ; reported (E017).

bareword        = 1*bare-char
                ; the minimally-quoted shape the FORMATTER emits. The PARSER is
                ; wider: everything after the ":" up to an unquoted "#" is the
                ; value, split on unquoted commas, each piece trimmed; a piece
                ; is quoted only when it BEGINS with a quote char. So a bare
                ; piece may carry mid-text spaces, ":", "'", "]", even '"',
                ; verbatim ("q: needs no quotes" loads clean). Bare, only a
                ; "#" after wsp (comment), "," (element split), a leading
                ; quote, and a leading "[" (bracket-array spelling, refused)
                ; keep their meaning. A "\" in bare text is a character.
bare-char       = bare-plain
bare-plain      = %x21 / %x24-2B / %x2D-39 / %x3B-5A / %x5C-10FFFF
                ; excludes SP HTAB , : # " [
                ; (0x20 0x09 0x2C 0x3A 0x23 0x22 0x5B).
                ; "'" 0x27, "\" 0x5C and "]" 0x5D are IN the ranges on purpose:
                ; the parser keeps all three bare (it's fine / C:\dir / a]b load
                ; clean, verbatim on read), though the formatter still quotes
                ; the first and last on output.

escape          = "\" non-newline
                ; inside double quotes only: \t \n \\ \" \' decode on read, and
                ; any other pair stays as written (\q reads back as \q). Single
                ; quotes and bare text never process a backslash.

;-----------------------------------------------------------------------------
; Block arrays (stacked list form)
;-----------------------------------------------------------------------------
; Sugar for the inline comma array (above): an empty-valued field whose child
; lines are all "* element" is identical to that field carrying the inline
; array of the same elements. Context-sensitive (indentation), enforced in
; prose (spec.md, "Arrays"):
;   - opens only under a field-line whose inline value is EMPTY;
;   - uniform-or-nothing: at that child indent every line is an element or none;
;   - one element per line; a bare comma on the line is an error, not a split;
;   - scalars only (an element has no "field: value" children).
; The colon-less "* " head is what tells an element from a field: "*" is not a
; name-char, so it can never begin a field-line.

array-elem-line = indent "*" 1*wsp scalar *wsp [ comment ]

;-----------------------------------------------------------------------------
; Raw (fenced) blocks
;-----------------------------------------------------------------------------
; Fence termination and base-indent stripping are context-sensitive (spec.md).
; A block opens with >=3 identical fence chars; it closes at the first later
; line whose trimmed text is a run of the SAME char, length >= the opener.

fence-line      = indent fence-open *wsp [ comment ]
                ; a value line for the parent field (spec.md): fills the parent's
                ; empty value, or creates a new instance of the parent if it
                ; already carries one - same rule as a repeated leaf.
fence-open      = fence-run [ info-string ]
fence-run       = 3*"`" / 3*"~"                 ; run length N captured for close-match
info-string     = *wsp 1*bare-plain *( *wsp 1*bare-plain )
                                               ; optional label (e.g. a language), read
                                               ; as bare text: a "#" glued to it is part
                                               ; of it (c#), one after a wsp opens the
                                               ; line's comment, in either spelling
raw-content-line= *non-newline                 ; verbatim; only while a fence is open
; fence-close (context): indent (N*"`" / N*"~") *wsp   where char matches opener
;                        and length >= opener length.

;-----------------------------------------------------------------------------
; Terminals
;-----------------------------------------------------------------------------

wsp             = SP / HTAB
non-newline     = %x00-09 / %x0B-10FFFF        ; any char except LF
newline         = *CR LF / %xEOF               ; LF or CRLF; a line's whole trailing CR run
                                               ; is removed; last line may lack newline
DQUOTE          = %x22
SQUOTE          = %x27
