# string, required
srv: web

	# int, repeat 1
	port:

	# string, required
	host: "a b"

		# string, required
		zone:
opt:

	# string
	#opt: x

	# int, required
	child:

# string, required
odd: "a]b"

	# int, required
	under:

# string, required
bare:

	# int, required
	leaf:

