# Port the server listens on.
# int, 1-65535, required
server.port: 8080

# Log verbosity.
# string, one of: debug, info, warn
#log.level: info

# Request timeout in seconds.
# float, >= 0.5
#server.timeout:

# Enabled feature flags.
# string-array
#features:

# int, repeat 1-5
#replicas:

# Paths needing an instance name (not generated):
#   server[*].host   string
